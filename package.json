{
  "name": "magazyn-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "typecheck": "tsc",
    "db": "docker compose exec db psql -U magazyn -d magazyn_api",
    "db:schema": "docker compose exec -T db psql -U magazyn -d magazyn_api -v ON_ERROR_STOP=1 < db/schema.sql"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
